{
  "name": "@fsp/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API платформы подбора (NestJS, модульный монолит)",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsc -p tsconfig.build.json && node dist/scripts/seed.js",
    "bank:manifest": "tsx scripts/bank-manifest.ts",
    "validate:quality": "tsx scripts/validate-quality.ts",
    "openapi:export": "pnpm run build && node dist/scripts/export-openapi.js",
    "fixtures:fsp": "tsx scripts/generate-fsp-fixture.ts",
    "build:scripts": "tsc -p tsconfig.build.json",
    "db:seed:reset": "tsc -p tsconfig.build.json && node dist/scripts/seed.js --reset"
  },
  "dependencies": {
    "@fsp/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.14",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fsp/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}

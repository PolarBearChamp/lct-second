{
  "name": "@fsp/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Сквозные проверки (Playwright) против запущенного стенда: web + api + postgres + mailpit",
  "scripts": {
    "test": "playwright test",
    "install-browsers": "playwright install chromium",

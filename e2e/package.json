    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fsp/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "eslint": "9.39.5",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}

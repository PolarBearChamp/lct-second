# ─────────────────────────────────────────────────────────────────────────────
# Пример конфигурации. Скопируйте в .env и при необходимости измените значения.
# Секретов здесь нет: значения ниже предназначены только для локального запуска.
# ─────────────────────────────────────────────────────────────────────────────

# Режим: development | production | test
NODE_ENV=development

# ── База данных ──────────────────────────────────────────────────────────────
# Docker Compose (сервис postgres). Порт хоста 5433, чтобы не конфликтовать с локальным PostgreSQL.
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_local_password
POSTGRES_DB=fsp
POSTGRES_HOST_PORT=5433
# URL для запуска API и миграций с хоста (pnpm dev / pnpm db:migrate)
DATABASE_URL=postgresql://fsp:fsp_local_password@localhost:5433/fsp?schema=public
# Отдельная БД для интеграционных тестов (создаётся init-скриптом контейнера postgres)
TEST_DATABASE_URL=postgresql://fsp:fsp_local_password@localhost:5433/fsp_test?schema=public

# ── Адреса ───────────────────────────────────────────────────────────────────
# Origin веб-приложения (браузер обращается к /api/v1 на этом же origin)
APP_ORIGIN=http://localhost:3000
# Внутренний URL API для серверных запросов Next.js и проксирования /api/v1
API_INTERNAL_URL=http://localhost:3001
# Порт API
PORT=3001
# Доверенные прокси для X-Forwarded-For (express trust proxy)
TRUST_PROXY=loopback, linklocal, uniquelocal

# ── Сессии и CSRF ────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=fsp_session
SESSION_TTL_HOURS=168
# В production должно быть true (только HTTPS). Локально по HTTP — false.
SESSION_COOKIE_SECURE=false
# Секрет для подписи CSRF-токенов. Обязателен. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=change-me-local-dev-secret-0123456789abcdef

# ── Почта ────────────────────────────────────────────────────────────────────
# Локально — Mailpit (UI: http://localhost:8025). Для внешнего стенда — реальный SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
# Docker Compose: адрес SMTP внутри сети контейнеров (по умолчанию сервис mailpit:1025). Значения SMTP_HOST/SMTP_PORT
# выше относятся к запуску на хосте и в контейнеры не передаются. Для внешнего стенда: DOCKER_SMTP_HOST=smtp.example.org,
# DOCKER_SMTP_PORT=587, SMTP_SECURE/SMTP_USER/SMTP_PASSWORD по требованиям провайдера.
# DOCKER_SMTP_HOST=mailpit
# DOCKER_SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ФСП Таланты <no-reply@fsp-talent.example>
EMAIL_VERIFICATION_TTL_HOURS=24

# ── Интеграция ФСП ───────────────────────────────────────────────────────────
# mock — демонстрационный провайдер с синтетическими данными (data/fixtures/fsp-mock.json)
FSP_PROVIDER=mock

# ── Версии политик (серверная конфигурация) ──────────────────────────────────
ASSESSMENT_POLICY_VERSION=assessment-policy-v1
MATCHING_FORMULA_VERSION=matching-formula-v1
INVITATION_POLICY_VERSION=invitation-policy-v1

# ── API-документация ─────────────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ── Демонстрационные данные (только локальный seed, не используется в production-старте) ──
# Пароль всех демонстрационных аккаунтов. Если пусто — используется значение из README (деморежим).
SEED_DEMO_PASSWORD=
# Только для нагрузочного прогона: кандидатов на каждую ячейку «специализация × грейд» (по умолчанию 8 → 96 основных кандидатов; 84 → около 1000).
# SEED_PER_CELL=8

# ── Логирование ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

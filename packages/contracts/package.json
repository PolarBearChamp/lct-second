{
  "name": "@fsp/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Безопасные общие типы, перечисления и подписи API. Не содержит ключей проверки, генераторов заданий и скрытых параметров.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fsp/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
